{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!assets/|input_file_1.png|logo.png|favicon.ico).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
